# Copy to .env and fill in values.
# Chrome: install Google Chrome. Selenium 4 downloads a matching ChromeDriver automatically.

START_URL=https://www.dmv.ca.gov/portal/appointments/select-appointment-type

# real_id_cdl | automobile | commercial | motorcycle
APPOINTMENT_CATEGORY=automobile

# Required to reach the scheduler after selecting a category
DMV_DL_NUMBER=
DMV_DOB=

# --- Santa Clara Field Office (example) ---
# 3665 Flora Vista Ave, Santa Clara, CA 95051 | Hours on site often listed 8:00 am–5:00 pm
# Use ZIP so the office list narrows; then click the row whose label contains the text below.
DMV_ZIP_CODE=95051
DMV_OFFICE_CLICK_TEXT=Santa Clara

# Polling
POLL_INTERVAL_SECONDS=120
PAGE_LOAD_TIMEOUT_SECONDS=45
IMPLICIT_WAIT_SECONDS=8

# Run browser without UI (may be blocked more often by sites)
HEADLESS=0

# Availability: comma-separated CSS selectors for clickable time-slot elements (recommended)
# Leave empty to fall back to time-pattern heuristics after negative-phrase checks.
SLOT_CSS_SELECTORS=

# How many matching visible elements count as "slots open"
SLOT_MIN_COUNT=1

# Only alert when parsed appointment times fall near a local clock hour (e.g. 1 PM).
# Times are parsed from page text and from SLOT_CSS_SELECTORS element labels.
SLOT_FILTER_NEAR_HOUR_LOCAL_ENABLED=1
SLOT_TARGET_HOUR_24=13
SLOT_TARGET_WINDOW_MINUTES=45

# Comma-separated phrases (case-insensitive). If any appear, we treat as NO slots.
NEGATIVE_PHRASES=no appointments available,no appointment times,there are currently no appointments,no times available,fully booked,try again later

# Email (Gmail example: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Only send one alert per cooldown window (minutes) while slots still look open
ALERT_COOLDOWN_MINUTES=30
